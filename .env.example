# Chave da API da Anthropic (opcional: sem ela o jogo usa só o banco de cartas local)
ANTHROPIC_API_KEY=
PORT=3000
# Controle de custos da IA
AI_DAILY_BUDGET_USD=5
AI_MAX_COST_PER_CALL_USD=0.5
AI_USER_DAILY_LIMIT=30
# Libera o relatório de consumo em /api/admin/usage
ADMIN_TOKEN=
# Arquivo do banco SQLite
DB_PATH=./data/perfil.db
# Cartas da internet (Wikipédia), sem IA
WEB_USER_DAILY_LIMIT=30
# Identificação do seu servidor para a Wikimedia (pode incluir um e-mail de contato)
WIKI_USER_AGENT=PerfilIA/1.0 (jogo de adivinhacao educativo)
